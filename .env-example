# App Config
PORT=3000

# Database Config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sitetrack_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_TYPE=postgres
DATABASE_SYNCHRONIZE=true

# JWT Config
